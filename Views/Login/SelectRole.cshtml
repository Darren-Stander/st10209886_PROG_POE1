@{
    ViewData["Title"] = "Select Role";
}

<div class="container mt-5">
    <h2 class="text-center">Select Your Role</h2>
    <p class="text-center">Choose your role to log in:</p>
    <div class="d-flex justify-content-center mt-4">
        <a asp-action="Index" asp-route-role="Lecturer" class="btn btn-primary mx-2">Lecturer</a>
        <a asp-action="Index" asp-route-role="Coordinator" class="btn btn-secondary mx-2">Coordinator</a>
        <a asp-action="Index" asp-route-role="HR" class="btn btn-danger mx-2">HR</a>
    </div>
</div>
