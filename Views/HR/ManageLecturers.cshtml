@model IEnumerable<st10209886_PROG_POE1.Models.Lecturer>

<div class="container mt-5">
    <h2 class="text-center">Manage Lecturers</h2>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Lecturer ID</th>
                <th>Lecturer Number</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lecturer in Model)
            {
                <tr>
                    <td>@lecturer.LecturerId</td>
                    <td>@lecturer.LecturerNumber</td>
                    <td>@lecturer.Name</td>
                    <td>@lecturer.Email</td>
                    <td>@lecturer.Phone</td>
                    <td>
                        <a asp-action="EditLecturer" asp-route-id="@lecturer.LecturerId" class="btn btn-warning">Edit</a>
                        <a asp-action="DeleteLecturer" asp-route-id="@lecturer.LecturerId" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
