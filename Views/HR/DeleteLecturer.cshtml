@model st10209886_PROG_POE1.Models.Lecturer

<h2>Delete Lecturer</h2>
<p>Are you sure you want to delete this lecturer?</p>
<div>
    <h4>@Model.Name</h4>
    <dl class="row">
        <dt class="col-sm-2">Lecturer Number</dt>
        <dd class="col-sm-10">@Model.LecturerNumber</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Model.Phone</dd>
    </dl>
</div>
<form asp-action="DeleteLecturerConfirmed" method="post">
    <input type="hidden" asp-for="LecturerId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="ManageLecturers" class="btn btn-secondary">Cancel</a>
</form>
