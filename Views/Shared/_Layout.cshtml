<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - st10209886_PROG_POE1</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #121212;
            color: #ffffff;
        }

        .navbar {
            background-color: #1f1f1f;
        }

            .navbar .nav-link, .navbar-brand {
                color: #ffffff !important;
            }

                .navbar .nav-link:hover {
                    color: #cccccc !important;
                }

        .btn-logout:hover {
            background-color: #dc3545;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark">
            <a class="navbar-brand" href="/">CMCS</a>
            <div class="collapse navbar-collapse">
                @if (User.Identity.IsAuthenticated)
                {
                    var selectedRole = Context.Session.GetString("SelectedRole");
                    if (selectedRole != null)
                    {
                        <ul class="navbar-nav mr-auto">
                            @if (selectedRole == "Lecturer")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/Claim/Submit">Submit Claim</a>
                                </li>
                            }
                            @if (selectedRole == "Coordinator")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/Claim/Coordinators">Coordinators</a>
                                </li>
                            }
                            @if (selectedRole == "HR")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="/Claim/ClaimStatus">Claim Status</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/HR/ManageLecturers">Manage Lecturers</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/HR/ApprovedClaims">View Approved Claims</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/HR/AddLecturer">Add Lecturer</a>
                                </li>
                            }
                        </ul>
                    }
                }
            </div>
            <!-- Logout Button -->
            @if (User.Identity.IsAuthenticated)
            {
                <a class="btn btn-danger" asp-action="Logout" asp-controller="Login">Logout</a>
            }
        </nav>
    </header>
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
